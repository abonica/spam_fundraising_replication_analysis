> # Formatting helper
> section_header <- function(title) {
+   rule <- paste(rep("=", 75), collapse = "")
+   cat("\n", rule, "\n", sep = "")
+   cat("  ", title, "\n", sep = "")
+   cat(rule, "\n\n", sep = "")
+ }
